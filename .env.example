# CivicLens Environment Configuration

# Google Maps Android API Key
# 1. Enable "Maps SDK for Android" in Google Cloud Console
# 2. Add API key below and inside app.json under expo.android.config.googleMaps.apiKey
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_android_api_key_here

# Firebase Configuration (No-cost tier)
# Enable Authentication (Email/Password), Cloud Firestore, and Firebase Storage
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=civiclens-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=civiclens-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=civiclens-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
